@model TurnoFormViewModel
@{
    ViewData["Title"] = "Nuevo turno";
}
<h2 class="page-title mb-3">Nuevo turno</h2>
<div class="card" style="max-width: 700px;"><div class="card-body">
    <form asp-action="Create" method="post" data-once>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="ClienteId" class="form-label"></label>
            <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select"><option value="">-- Seleccione un cliente --</option></select>
            <span asp-validation-for="ClienteId" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="BarberoId" class="form-label"></label>
                <select asp-for="BarberoId" asp-items="Model.Barberos" class="form-select"><option value="">-- Seleccione un barbero --</option></select>
                <span asp-validation-for="BarberoId" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ServicioId" class="form-label"></label>
                <select asp-for="ServicioId" asp-items="Model.Servicios" class="form-select"><option value="">-- Seleccione un servicio --</option></select>
                <span asp-validation-for="ServicioId" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="FechaHora" class="form-label"></label>
            <input asp-for="FechaHora" type="datetime-local" class="form-control" />
            <span asp-validation-for="FechaHora" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Notas" class="form-label">Notas (opcional)</label>
            <textarea asp-for="Notas" class="form-control" rows="2" maxlength="250"></textarea>
            <span asp-validation-for="Notas" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Guardar turno</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div></div>
