@model List<Turno>
@{
    ViewData["Title"] = "Turnos";
    var fecha = (DateTime)ViewData["Fecha"]!;
    var fechaTxt = fecha.ToString("yyyy-MM-dd");
    var q = ViewData["q"] as string;
    var buscando = !string.IsNullOrWhiteSpace(q);
    string Badge(EstadoTurno e) => e switch
    {
        EstadoTurno.Pendiente => "text-bg-warning",
        EstadoTurno.Confirmado => "text-bg-info",
        EstadoTurno.Completado => "text-bg-success",
        _ => "text-bg-secondary"
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="page-title">Turnos</h2>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo turno</a>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-12 col-md-3">
        <label class="form-label small mb-1">Día</label>
        <input type="date" name="fecha" value="@fechaTxt" class="form-control" />
    </div>
    <div class="col-12 col-md-5">
        <label class="form-label small mb-1">Buscar por cliente o barbero (todas las fechas)</label>
        <input name="q" value="@q" class="form-control" placeholder="Nombre del cliente o del barbero" />
    </div>
    <div class="col-auto">
        <button class="btn btn-dark"><i class="bi bi-search"></i> Consultar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hoy</a>
    </div>
</form>

<p class="text-secondary">
    @if (buscando) { <span>Resultados para "<strong>@q</strong>" en todas las fechas.</span> }
    else { <span>Turnos del <strong>@fecha.ToString("dd/MM/yyyy")</strong>.</span> }
</p>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Fecha</th><th>Hora</th><th>Cliente</th><th>Barbero</th><th>Servicio</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.FechaHoraInicio.ToString("dd/MM/yyyy")</td>
                <td>@t.FechaHoraInicio.ToString("HH:mm") - @t.FechaHoraFin.ToString("HH:mm")</td>
                <td>@t.Cliente?.Nombre</td>
                <td>@t.Barbero?.Nombre</td>
                <td>@t.Servicio?.Nombre <span class="text-secondary small">(@t.DuracionMinutos min)</span></td>
                <td><span class="badge @Badge(t.Estado)">@t.Estado</span></td>
                <td class="text-end text-nowrap">
                    @if (t.Estado == EstadoTurno.Pendiente)
                    {
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="estado" value="Confirmado" />
                            <input type="hidden" name="fecha" value="@fechaTxt" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Confirmar</button>
                        </form>
                    }
                    @if (t.Estado is EstadoTurno.Pendiente or EstadoTurno.Confirmado)
                    {
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="estado" value="Completado" />
                            <input type="hidden" name="fecha" value="@fechaTxt" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Completar</button>
                        </form>
                        <a class="btn btn-sm btn-outline-dark" asp-action="Reprogramar" asp-route-id="@t.Id"><i class="bi bi-calendar2-week"></i> Reprogramar</a>
                        <form asp-action="Cancelar" method="post" class="d-inline" data-confirm="@("¿Cancelar el turno de " + t.Cliente?.Nombre + "?")">
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="fecha" value="@fechaTxt" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Cancelar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-secondary py-4">No hay turnos para mostrar.</td></tr>
        }
        </tbody>
    </table>
</div>
