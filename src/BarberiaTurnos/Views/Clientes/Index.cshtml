@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="page-title">Clientes</h2>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo cliente</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6 col-lg-4">
        <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por nombre o teléfono" />
    </div>
    <div class="col-auto">
        <button class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>ID</th><th>Nombre</th><th>Teléfono</th><th>Fecha de registro</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Nombre</td>
                <td>@c.Telefono</td>
                <td>@c.FechaRegistro.ToString("dd/MM/yyyy")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i> Editar</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="¿Eliminar al cliente @c.Nombre? Esta acción no se puede deshacer.">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-secondary py-4">No se encontraron clientes.</td></tr>
        }
        </tbody>
    </table>
</div>
