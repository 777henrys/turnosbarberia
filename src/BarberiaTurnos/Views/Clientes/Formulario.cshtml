@model Cliente
@{
    var nuevo = Model.Id == 0;
    ViewData["Title"] = nuevo ? "Nuevo cliente" : "Editar cliente";
}
<h2 class="page-title mb-3">@ViewData["Title"]</h2>
<div class="card" style="max-width: 600px;"><div class="card-body">
    <form asp-action="@(nuevo ? "Create" : "Edit")" method="post" data-once>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" maxlength="100" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" class="form-control" maxlength="20" />
            <span asp-validation-for="Telefono" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div></div>
