@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Act(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var esAdmin = User.IsInRole(Roles.Administrador);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Barbería</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (autenticado)
{
    <div class="d-lg-none topbar d-flex align-items-center justify-content-between px-3 py-2">
        <span class="brand"><i class="bi bi-scissors"></i> Barbería</span>
        <button class="btn btn-outline-gold btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu" aria-controls="menu">
            <i class="bi bi-list"></i> Menú
        </button>
    </div>
    <div class="layout">
        <aside class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="menu">
            <div class="offcanvas-header d-lg-none">
                <span class="brand"><i class="bi bi-scissors"></i> Barbería</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#menu" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body flex-column p-0">
                <div class="brand d-none d-lg-block px-4 py-4"><i class="bi bi-scissors"></i> Barbería<small>Sistema de turnos</small></div>
                <nav class="nav flex-column">
                    <a class="nav-link @Act("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Inicio</a>
                    <a class="nav-link @Act("Turnos")" asp-controller="Turnos" asp-action="Index"><i class="bi bi-calendar-check"></i> Turnos</a>
                    <a class="nav-link @Act("Clientes")" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people"></i> Clientes</a>
                    <a class="nav-link @Act("Barberos")" asp-controller="Barberos" asp-action="Index"><i class="bi bi-person-badge"></i> Barberos</a>
                    <a class="nav-link @Act("Servicios")" asp-controller="Servicios" asp-action="Index"><i class="bi bi-scissors"></i> Servicios</a>
                    <a class="nav-link @Act("Productos")" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam"></i> Productos</a>
                    <a class="nav-link @Act("Ventas")" asp-controller="Ventas" asp-action="Index"><i class="bi bi-receipt"></i> Ventas</a>
                    <a class="nav-link @Act("Reportes")" asp-controller="Reportes" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Reportes</a>
                    @if (esAdmin)
                    {
                        <div class="nav-section">Administración</div>
                        <a class="nav-link @Act("Usuarios")" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-shield-lock"></i> Usuarios</a>
                        <a class="nav-link @Act("Configuracion")" asp-controller="Configuracion" asp-action="Index"><i class="bi bi-gear"></i> Configuración</a>
                    }
                </nav>
                <div class="user-box mt-auto p-3">
                    <div class="small text-secondary">Sesión iniciada</div>
                    <div class="fw-semibold text-truncate">@User.Identity!.Name</div>
                    <div class="small text-gold mb-2">@(esAdmin ? Roles.Administrador : Roles.Empleado)</div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-gold btn-sm w-100"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                    </form>
                </div>
            </div>
        </aside>
        <main class="content">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @exito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
