@model List<UsuarioListaViewModel>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="page-title">Usuarios</h2>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo usuario</a>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.NombreCompleto</td>
                <td>@u.Email</td>
                <td>@u.Rol</td>
                <td>@if (u.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Desactivado</span> }</td>
                <td class="text-end">
                    <form asp-action="CambiarEstado" asp-route-id="@u.Id" method="post" class="d-inline"
                          data-confirm="@(u.Activo ? "¿Desactivar al usuario " + u.Email + "?" : "¿Activar al usuario " + u.Email + "?")">
                        <button type="submit" class="btn btn-sm @(u.Activo ? "btn-outline-danger" : "btn-outline-success")">@(u.Activo ? "Desactivar" : "Activar")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
