@model List<Producto>
@{
    ViewData["Title"] = "Productos";
    var esAdmin = User.IsInRole(Roles.Administrador);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="page-title">Productos e inventario</h2>
    @if (esAdmin)
    {
        <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
    }
</div>
@if (Model.Any(p => p.StockBajo))
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Hay @Model.Count(p => p.StockBajo) producto(s) con pocas existencias en esta lista.</div>
}
<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6 col-lg-4">
        <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por nombre o descripción" />
    </div>
    <div class="col-auto">
        <button class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>ID</th><th>Producto</th><th>Descripción</th><th class="text-end">Precio</th><th class="text-end">Cantidad</th><th class="text-end">Stock mínimo</th>@if (esAdmin) { <th class="text-end">Acciones</th> }</tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nombre</td>
                <td>@p.Descripcion</td>
                <td class="text-end">RD$ @p.Precio.ToString("N2")</td>
                <td class="text-end">
                    @p.Cantidad
                    @if (p.StockBajo) { <span class="badge text-bg-danger ms-1">Stock bajo</span> }
                </td>
                <td class="text-end">@p.StockMinimo</td>
                @if (esAdmin)
                {
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil"></i> Editar</a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-confirm="¿Eliminar el producto @p.Nombre? Esta acción no se puede deshacer.">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Eliminar</button>
                        </form>
                    </td>
                }
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-secondary py-4">No se encontraron productos.</td></tr>
        }
        </tbody>
    </table>
</div>
