@model List<Servicio>
@{
    ViewData["Title"] = "Servicios";
    var esAdmin = User.IsInRole(Roles.Administrador);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="page-title">Servicios</h2>
    @if (esAdmin)
    {
        <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo servicio</a>
    }
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6 col-lg-4">
        <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto">
        <button class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>ID</th><th>Servicio</th><th class="text-end">Precio</th><th class="text-end">Duración</th><th>Estado</th>@if (esAdmin) { <th class="text-end">Acciones</th> }</tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Nombre</td>
                <td class="text-end">RD$ @s.Precio.ToString("N2")</td>
                <td class="text-end">@s.DuracionMinutos min</td>
                <td>@if (s.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }</td>
                @if (esAdmin)
                {
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@s.Id"><i class="bi bi-pencil"></i> Editar</a>
                        <form asp-action="CambiarEstado" asp-route-id="@s.Id" method="post" class="d-inline"
                              data-confirm="@(s.Activo ? "¿Desactivar el servicio " + s.Nombre + "?" : "¿Activar el servicio " + s.Nombre + "?")">
                            <button type="submit" class="btn btn-sm @(s.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(s.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-secondary py-4">No se encontraron servicios.</td></tr>
        }
        </tbody>
    </table>
</div>
